# ──────────────────────────────────────────
# ToDO 任务管理器 后端环境变量配置
# 复制为 .env 后按实际环境修改
# ──────────────────────────────────────────

# 端口
CLIENT_PORT=8821
SERVER_PORT=8344

# 数据库路径 (相对于项目根目录)
# DB_PATH=server/data/taskflow.db

# 日志
# LOG_LEVEL=info
# LOG_SLOW_MS=1200

# JWT 配置 (生产环境必须修改为随机高强度密钥)
# JWT_SECRET=your-secret-change-in-production
# JWT_EXPIRES_IN=24h

# 初始超级管理员配置 (可选)
# 系统启动与用户首次登录时，为指定钉钉/系统用户 ID 自动赋予超级管理员权限 (super_admin)
# 支持逗号分隔多个用户 ID，例如：INITIAL_SUPER_ADMIN_IDS=admin_user_01,admin_user_02
# INITIAL_SUPER_ADMIN_IDS=

# 通知链接加密密钥 (至少32位，用于钉钉跳转链接防篡改与签名保护)
# NOTIFICATION_LINK_SECRET=your-random-32-character-secret-key

# 钉钉集成 (可选，不配置则钉钉登录/同步不可用)
# 免登与组织同步（企业内部应用）
# DINGTALK_INTERNAL_APP_KEY=
# DINGTALK_INTERNAL_APP_SECRET=
# 浏览器扫码登录（开放平台扫码应用）
# DINGTALK_QR_CLIENT_ID=
# DINGTALK_QR_CLIENT_SECRET=
# 企业内部应用机器人编码，管理后台"钉钉推送"通过单聊机器人发送（缺省回退到 DINGTALK_CLIENT_ID）
# DINGTALK_ROBOT_CODE=
# ActionCard 封面图片第三方图床（superbed），图片由服务端代传，密钥不暴露给前端
# IMAGE_BED_API_KEY=
# IMAGE_BED_API_URL=https://api.superbed.cn
# 兼容旧命名（会映射到内部应用配置）
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=
# DINGTALK_CORP_ID=
# DINGTALK_AGENT_ID=

# 反向代理
# TRUST_PROXY=true
# 对外可访问的应用地址，ActionCard 会用它生成 HTML 承载页链接
# APP_BASE_URL=https://todo.example.com
# 宣传承载页持久化目录，默认 server/data/broadcast-pages
# BROADCAST_PAGES_ROOT=/data/taskflow/broadcast-pages

# 钉钉人员定时自动同步（默认每天上海时间 09:36 执行）
# DINGTALK_AUTO_SYNC_ENABLED=true
# DINGTALK_SYNC_CRON=36 9 * * *
